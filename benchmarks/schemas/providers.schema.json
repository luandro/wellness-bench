{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://wellness-bench.github.io/schemas/providers.schema.json",
  "title": "Providers Configuration",
  "description": "Configuration for AI model providers (no secrets)",
  "type": "object",
  "required": ["version", "updated_at", "providers"],
  "properties": {
    "version": {
      "type": "string",
      "description": "Semantic version of the configuration format"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp of last update"
    },
    "providers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["provider_id", "display_name", "enabled", "auth_type", "env_key_name", "models"],
        "properties": {
          "provider_id": {
            "type": "string",
            "pattern": "^[a-z0-9_-]+$",
            "description": "Unique provider identifier"
          },
          "display_name": {
            "type": "string",
            "minLength": 1,
            "description": "Human-readable provider name"
          },
          "enabled": {
            "type": "boolean",
            "description": "Whether this provider is active"
          },
          "base_url": {
            "type": "string",
            "format": "uri",
            "description": "API base URL"
          },
          "auth_type": {
            "type": "string",
            "enum": ["bearer", "api-key"],
            "description": "Authentication method"
          },
          "env_key_name": {
            "type": "string",
            "pattern": "^[A-Z_]+$",
            "description": "Environment variable name for API key"
          },
          "models": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["id", "name", "enabled", "default_params"],
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1,
                  "description": "Model identifier used in API calls"
                },
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "description": "Human-readable model name"
                },
                "enabled": {
                  "type": "boolean",
                  "description": "Whether this model is active"
                },
                "version": {
                  "type": "string",
                  "description": "Optional model version identifier"
                },
                "default_params": {
                  "type": "object",
                  "required": ["temperature", "max_tokens"],
                  "properties": {
                    "temperature": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 2,
                      "description": "Sampling temperature"
                    },
                    "max_tokens": {
                      "type": "integer",
                      "minimum": 100,
                      "maximum": 128000,
                      "description": "Maximum output tokens"
                    }
                  },
                  "additionalProperties": true
                }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
