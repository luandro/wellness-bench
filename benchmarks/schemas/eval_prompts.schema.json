{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://wellness-bench.github.io/schemas/eval_prompts.schema.json",
  "title": "Evaluation Prompts Configuration",
  "description": "Configuration for evaluation prompts and bias taxonomy",
  "type": "object",
  "required": ["version", "updated_at", "answer_wrapper_prompt", "synthesis_prompt", "steps", "bias_taxonomy"],
  "properties": {
    "version": {
      "type": "string",
      "description": "Semantic version of the configuration format"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp of last update"
    },
    "answer_wrapper_prompt": {
      "type": "string",
      "minLength": 50,
      "description": "System prompt template for answer generation. Must contain {{question}} placeholder."
    },
    "synthesis_prompt": {
      "type": "string",
      "minLength": 50,
      "description": "Prompt template for cross-model synthesis. Must contain {{responses}} placeholder."
    },
    "translation_prompt_template": {
      "type": "string",
      "description": "Optional prompt template for i18n translation. Placeholders: {{text}}, {{source_language}}, {{target_language}}"
    },
    "steps": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {
        "type": "object",
        "required": ["id", "name", "description", "prompt_template", "output_schema"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^step-[a-e]$",
            "description": "Step identifier (step-a through step-e)"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "description": "Human-readable step name"
          },
          "description": {
            "type": "string",
            "description": "Description of what this step evaluates"
          },
          "prompt_template": {
            "type": "string",
            "minLength": 50,
            "description": "Prompt template. Must contain {{answer}} placeholder."
          },
          "output_schema": {
            "type": "object",
            "description": "JSON Schema for the expected output"
          }
        },
        "additionalProperties": false
      }
    },
    "bias_taxonomy": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "label", "description"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z_]+$",
            "description": "Unique bias identifier"
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "description": "Human-readable bias name"
          },
          "description": {
            "type": "string",
            "description": "Description of what this bias means"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
